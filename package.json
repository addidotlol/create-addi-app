  },
  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "dax-sh": "^0.44.1",
    "ejs": "^6.0.1",
    "fs-extra": "^11.4.0",
    "glob": "^13.0.6",
    "jsonc-parser": "^3.3.1",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-n": "^18.2.2",
