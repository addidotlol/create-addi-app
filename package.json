  "description": "Scaffolds an `addi-stack` app.",
  "main": "index.js",
  "type": "module",
  "bin": {
    "create-addi-stack": "index.js"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
